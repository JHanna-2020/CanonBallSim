module(name = "cannonball_sim", version = "0.1.0")

# Must be listed ABOVE rules_cc so Bazel uses the macOS Xcode toolchain
bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "nanobind_bazel", version = "3.1.0.bcr.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11", is_default = True)
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.11",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "pypi")
